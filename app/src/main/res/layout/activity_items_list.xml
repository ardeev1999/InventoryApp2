<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
<EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Название или инвентарный номер" android:inputType="text" android:maxLines="1" />
<TextView android:id="@+id/tvTotalCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" />
<androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
